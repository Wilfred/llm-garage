FROM node:24-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cargo \
    cmake \
    curl \
    docker.io \
    gh \
    git \
    jq \
    python-is-python3 \
    python3-pip \
    ripgrep \
    rustc \
  && rm -rf /var/lib/apt/lists/* \
  && pip --version \
  && rustc --version \
  && cargo --version \
  && cmake --version \
  && docker --version \
  && git config --system user.name "LLM Garage Agent" \
  && git config --system user.email "llm-garage-agent@users.noreply.github.com" \
  && git config --system credential.https://github.com.helper "!gh auth git-credential"

RUN useradd --create-home --uid 10001 --shell /bin/bash agent

ENV HOME=/home/agent GH_PROMPT_DISABLED=1
USER agent
WORKDIR /home/agent

CMD ["/bin/sh", "-c", "trap 'exit 0' TERM INT; while :; do sleep 3600 & wait $!; done"]
