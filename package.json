{
  "name": "llm-garage",
  "version": "0.1.0",
  "description": "Self-hosted harness for LLM coding agents: prompt + repo in, sandboxed agent run + PR out",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.{ts,tsx}\"",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wilfred/llm-garage.git"
  },
  "author": "Wilfred Hughes",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "markdown-it": "^15.0.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
