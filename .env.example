# Copy to .env and adjust. Defaults are fine for local dev.
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
# Required to start model conversations.
# OPENROUTER_API_KEY=sk-or-v1-...
# Required for the search_web worker tool.
# BRAVE_SEARCH_API_KEY=...
# Optional GitHub personal access token passed to trajectory containers.
# GITHUB_TOKEN=github_pat_...
# GitHub sign in, required unless HOST is loopback. The OAuth app's
# callback URL is <site>/auth/github/callback.
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
# Comma-separated GitHub logins allowed to sign in.
# AUTH_GITHUB_USERS=octocat
# Cookie signing key, e.g. from `openssl rand -base64 33`.
# AUTH_SECRET=...
# Override the published worker image used for trajectory containers.
# WORKER_IMAGE=ghcr.io/wilfred/llm-garage:worker
# Trajectories that run at the same time; the rest queue.
# MAX_RUNNING_TRAJECTORIES=2
# How long one agent command may run before it is stopped.
# COMMAND_TIMEOUT_SECONDS=900
